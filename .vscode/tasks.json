{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ZARC: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "desktop-linux"
      ],
      "problemMatcher": [],
      "windows": {
        "args": [
          "--preset",
          "desktop-windows"
        ]
      }
    },
    {
      "label": "ZARC: build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "desktop-linux"
      ],
      "dependsOn": "ZARC: configure",
      "problemMatcher": [
        "$msCompile"
      ],
      "group": "build",
      "windows": {
        "args": [
          "--build",
          "--preset",
          "desktop-windows"
        ]
      }
    },
    {
      "label": "ZARC: test",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--preset",
        "desktop-linux"
      ],
      "dependsOn": "ZARC: build",
      "problemMatcher": [],
      "group": "test",
      "windows": {
        "args": [
          "--preset",
          "desktop-windows"
        ]
      }
    }
  ]
}
